# --- PostgreSQL ---
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace_dev_password
POSTGRES_DB=marketplace
DATABASE_URL=postgresql://marketplace:marketplace_dev_password@localhost:5432/marketplace?schema=public
DATABASE_URL_REPLICA=

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=mkpl:

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000/api/v1
NODE_ENV=development
LOG_LEVEL=info

# --- Auth / JWT (dev only; в prod — генерировать свои и хранить в Secret Manager) ---
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false

# --- Rate limiting (Redis) ---
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_GLOBAL_WINDOW=60s

# --- Object storage (MinIO в dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/media

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Worker ---
WORKER_CONCURRENCY=10
