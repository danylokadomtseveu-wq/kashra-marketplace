# ============================================================
# PRODUCTION environment — СКОПИРУЙТЕ в .env.production и ЗАМЕНИТЕ ВСЕ секреты.
# Никогда не коммитьте этот файл с реальными значениями.
# Хранение секретов: env file на сервере (chmod 600) или Secret Manager (doppler/vault).
# ============================================================

# --- Сеть (внутри Docker-сети; host = имя сервиса в compose) ---
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=marketplace
DATABASE_URL=postgresql://marketplace:CHANGE_ME_STRONG_PASSWORD@postgres:5432/marketplace?schema=public&connection_limit=10&pool_timeout=10
# Реплика чтения: при масштабировании укажите URL реплики, иначе пусто
DATABASE_URL_REPLICA=

REDIS_URL=redis://redis:6379
REDIS_PREFIX=mkpl:

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=https://api.example.com/api/v1
NODE_ENV=production
LOG_LEVEL=info

# --- Auth / JWT: СГЕНЕРИРУЙТЕ: openssl rand -base64 48 ---
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d
COOKIE_SECURE=true

# --- Rate limiting (Redis) ---
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_GLOBAL_WINDOW=60s

# --- Object storage (MinIO в prod-стеке; в облаке — S3) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY=CHANGE_ME_MINIO
S3_SECRET_KEY=CHANGE_ME_MINIO
S3_PUBLIC_URL=https://cdn.example.com

# --- Web (внутри Docker-сети) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# --- Worker ---
WORKER_CONCURRENCY=10

# --- Образы (registry) ---
REGISTRY=
IMAGE_NAMESPACE=yourorg
IMAGE_TAG=latest

# --- Лимиты ресурсов ---
API_CPUS=1.0
API_MEMORY=512M
WORKER_CPUS=1.0
WORKER_MEMORY=512M
REDIS_MAXMEMORY=512mb
