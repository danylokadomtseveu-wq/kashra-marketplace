generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  DELETED
}

enum SellerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProductAvailability {
  ACTIVE
  PAUSED
  SOLD_OUT
  HIDDEN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PROGRESS
  DELIVERED
  CONFIRMED
  CANCELLED
  REFUNDED
  DISPUTED
  COMPLETED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  WALLET
  STRIPE
  YOOKASSA
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum CouponType {
  PERCENT
  FIXED
}

enum PromotionType {
  PERCENT
  FIXED
}

enum NotificationType {
  ORDER
  PAYMENT
  REVIEW
  SYSTEM
  PROMOTION
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  MODERATE
  BAN
  REFUND
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  status       UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sellerProfile  SellerProfile?
  cart           Cart?
  orders         Order[]
  reviews        Review[]
  favorites      Favorite[]
  notifications  Notification[]
  addresses      Address[]
  auditLogs      AuditLog[]
  wallet         WalletBalance?
  payments       Payment[]
}

model WalletBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  available Decimal  @default(0) @db.Decimal(12, 2)
  frozen    Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
}

model SellerProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  description      String   @default("")
  verificationStatus SellerVerificationStatus @default(PENDING)
  ratingCache      Decimal  @default(0) @db.Decimal(3, 2)
  salesCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([verificationStatus])
}

model Category {
  id       String   @id @default(cuid())
  slug     String   @unique
  name     String
  parentId String?
  sort     Int      @default(0)
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([isActive, sort])
}

model Brand {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  products Product[]

  @@index([slug])
}

model Product {
  id         String   @id @default(cuid())
  slug       String   @unique
  sellerId   String
  categoryId String
  brandId    String?
  title      String
  description String  @default("")
  price      Decimal  @db.Decimal(12, 2)
  oldPrice   Decimal? @db.Decimal(12, 2)
  currency   String   @default("RUB") @db.VarChar(3)
  availability ProductAvailability @default(ACTIVE)
  attrs      Json     @default("{}")
  ratingCache Decimal @default(0) @db.Decimal(3, 2)
  reviewCount Int     @default(0)
  publishedAt DateTime @default(now())
  softDeleted Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  seller   SellerProfile @relation(fields: [sellerId], references: [id])
  category Category       @relation(fields: [categoryId], references: [id])
  brand    Brand?         @relation(fields: [brandId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]
  inventory Inventory?
  orderItems OrderItem[]
  reviews    Review[]
  favorites  Favorite[]
  cartItems  CartItem[]

  @@index([categoryId, availability, publishedAt(sort: Desc)])
  @@index([sellerId])
  @@index([availability, price])
  @@index([publishedAt(sort: Desc)])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  title     String
  attrs     Json    @default("{}")
  price     Decimal? @db.Decimal(12, 2)
  stock     Int     @default(0)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory?

  @@index([productId])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String  @default("")
  sort      Int     @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sort])
}

model Inventory {
  id        String  @id @default(cuid())
  productId String  @unique
  variantId String? @unique
  stock     Int     @default(0)
  reserved  Int     @default(0)
  updatedAt DateTime @updatedAt

  product       Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  reservations  InventoryReservation[]

  @@index([variantId])
}

model InventoryReservation {
  id        String   @id @default(cuid())
  inventoryId String
  orderId   String
  qty       Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])

  @@index([status, expiresAt])
  @@index([orderId])
}

model Cart {
  id      String @id @default(cuid())
  userId  String? @unique
  guestId String? @unique
  mergedAt DateTime?

  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([guestId])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  qty       Int    @default(1)
  createdAt DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId, variantId])
}

model Order {
  id             String   @id @default(cuid())
  userId         String
  status         OrderStatus @default(PENDING_PAYMENT)
  total          Decimal  @db.Decimal(12, 2)
  currency       String   @default("RUB") @db.VarChar(3)
  itemsSummary   Json     @default("{}")
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User         @relation(fields: [userId], references: [id])
  items      OrderItem[]
  payments   Payment[]
  reservations InventoryReservation[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  title     String
  price     Decimal @db.Decimal(12, 2)
  qty       Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String?
  userId            String?
  walletBalanceId   String?
  provider          PaymentProvider @default(WALLET)
  providerPaymentId String?  @unique
  amount            Decimal  @db.Decimal(12, 2)
  status            PaymentStatus @default(CREATED)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order       Order?         @relation(fields: [orderId], references: [id])
  user        User?          @relation(fields: [userId], references: [id])
  wallet      WalletBalance? @relation(fields: [walletBalanceId], references: [id])
  events      PaymentEvent[]

  @@index([orderId])
  @@index([userId])
}

model PaymentEvent {
  id          String   @id @default(cuid())
  paymentId   String
  type        String
  payload     Json     @default("{}")
  raw         Json?
  processedAt DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, processedAt])
}

model Address {
  id        String @id @default(cuid())
  userId    String
  title     String @default("")
  line1     String
  line2     String?
  city      String
  country   String
  postalCode String?
  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  authorId  String
  rating    Int
  text      String
  moderated Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@unique([productId, authorId])
  @@index([productId, moderated, createdAt(sort: Desc)])
  @@index([authorId])
}

model Favorite {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, createdAt(sort: Desc)])
}

model Coupon {
  id        String   @id @default(cuid())
  code      String   @unique
  type      CouponType
  value     Decimal  @db.Decimal(12, 2)
  maxUses   Int      @default(1)
  usedCount Int      @default(0)
  expiresAt DateTime?

  @@index([expiresAt])
}

model Promotion {
  id       String   @id @default(cuid())
  title    String
  type     PromotionType
  value    Decimal  @db.Decimal(12, 2)
  startsAt DateTime
  endsAt   DateTime
  scope    Json     @default("{}")

  @@index([startsAt, endsAt])
}

model Notification {
  id      String   @id @default(cuid())
  userId  String
  type    NotificationType
  payload Json     @default("{}")
  readAt  DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model OutboxEvent {
  id          String   @id @default(cuid())
  eventType   String
  payload     Json     @default("{}")
  status      OutboxStatus @default(PENDING)
  attempts    Int      @default(0)
  lockUntil   DateTime?
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([status, lockUntil])
  @@index([createdAt])
}

model IdempotencyKey {
  key       String   @id
  response  Json
  expiresAt DateTime

  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    AuditAction
  entityType String
  entityId  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt])
}
